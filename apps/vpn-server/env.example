# =============================================================================
# vpnVPN VPN Server (apps/vpn-server) Environment Configuration
# =============================================================================
# Every variable the vpn-server binary actually reads. Only API_URL and
# VPN_TOKEN are required; everything else has a default or is auto-detected
# at startup (detected public IP, generated PKI, geolocation lookup).

# -----------------------------------------------------------------------------
# Required: control plane connection
# -----------------------------------------------------------------------------
# Control plane base URL (clap: --api-url).
API_URL=https://control-plane.example.com
# Node registration bearer token (clap: --token). Created via the admin panel.
VPN_TOKEN=your-node-registration-token

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# Server identity reported to the control plane.
# Default: $HOSTNAME, then "vpn-node".
# SERVER_ID=my-vpn-node-1
# Comma-separated protocols to enable. Default: wireguard,openvpn,ikev2
# VPN_PROTOCOLS=wireguard,openvpn,ikev2
# WireGuard UDP listen port. Default: 51820
# LISTEN_UDP_PORT=51820
# Admin/metrics HTTP port (/health, /metrics, gated admin endpoints). Default: 8080
# ADMIN_PORT=8080

# -----------------------------------------------------------------------------
# Metrics & admin API (optional)
# -----------------------------------------------------------------------------
# Control-plane ingestion endpoint, e.g. ${API_URL}/metrics/vpn.
# Unset: metrics are exposed on /metrics only, nothing is pushed.
# METRICS_URL=https://control-plane.example.com/metrics/vpn
# Bearer token gating the node's admin endpoints (/status, /logs, /pubkey).
# Unset: those endpoints return 403 (safe default).
# ADMIN_API_TOKEN=

# -----------------------------------------------------------------------------
# Location labels (optional)
# -----------------------------------------------------------------------------
# When either is unset, the node geolocates its public IP at startup.
# VPN_COUNTRY=DE
# VPN_REGION=eu-central

# -----------------------------------------------------------------------------
# Advertised endpoints (optional overrides)
# -----------------------------------------------------------------------------
# What the node registers with the control plane for clients to connect to.
# All are auto-derived from the detected public IP / configured ports when
# unset — set them only behind NAT/load balancers or with custom DNS.
# VPN_WG_ENDPOINT=vpn1.example.com        # default: detected public IP
# VPN_WG_PORT=51820                       # default: LISTEN_UDP_PORT
# VPN_OVPN_ENDPOINT=vpn1.example.com      # default: detected public IP
# VPN_OVPN_PORT=1194                      # default: 1194
# VPN_IKEV2_REMOTE=vpn1.example.com:500   # default: <detected public IP>:500

# -----------------------------------------------------------------------------
# OpenVPN (optional)
# -----------------------------------------------------------------------------
# Local OpenVPN listen port. Default: 1194
# OPENVPN_PORT=1194
# Pre-provisioned PKI (PEM CA bundle + server cert SHA-256 fingerprint).
# Unset: the node generates a shared CA/server cert on first start.
# VPN_OVPN_CA_BUNDLE=
# VPN_OVPN_PEER_FINGERPRINT=
# tls-crypt group key advertised to clients. Auto-generated when unset.
# VPN_OVPN_TLS_CRYPT_KEY=

# -----------------------------------------------------------------------------
# IKEv2 (optional)
# -----------------------------------------------------------------------------
# Set to "false" to disable IKEv2 even when listed in VPN_PROTOCOLS. Default: true
# IKEV2_ENABLED=true
# Server identity (leftid). Default: detected public IP, then "vpnvpn-ikev2".
# IKEV2_IDENTITY=
# Address clients connect to. Default: detected public IP.
# IKEV2_REMOTE=
# IKE UDP port. Default: 500
# IKEV2_PORT=500
# Virtual IP pools handed to clients. Defaults: 10.9.0.0/24 / fd42:42:42::/64
# IKEV2_POOL_V4=10.9.0.0/24
# IKEV2_POOL_V6=fd42:42:42::/64
# IKEv2 PKI advertised to clients (PEM CA bundle + server cert fingerprint).
# Auto-derived from the shared PKI when unset.
# VPN_IKEV2_CA_BUNDLE=
# VPN_IKEV2_FINGERPRINT=

# -----------------------------------------------------------------------------
# Static peer (local/docker tests only — bypasses control-plane peer sync)
# -----------------------------------------------------------------------------
# STATIC_PEER_PUBLIC_KEY=
# STATIC_PEER_ALLOWED_IPS=10.8.0.2/32
# STATIC_PEER_ENDPOINT=host:51820
