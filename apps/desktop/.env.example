# Required environment variables for the desktop app
VITE_API_BASE_URL=http://localhost:3000
VITE_APP_CHANNEL=devel

# macOS daemon IPC security (build-time): the Apple Team ID the daemon pins for
# code-signature verification of the connecting GUI. REQUIRED for macOS release
# builds (daemon/build.rs enforces it). For unsigned/local release builds set
# VPNVPN_ALLOW_UNPINNED_TEAM_ID=1 instead. Unused in debug builds.
# VPNVPN_EXPECTED_TEAM_ID=ABCDE12345
# VPNVPN_ALLOW_UNPINNED_TEAM_ID=1
