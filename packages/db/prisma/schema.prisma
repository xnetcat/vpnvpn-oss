// Prisma schema for Auth.js (NextAuth) + Stripe subscriptions + control plane

generator client {
  provider      = "prisma-client-js"
  // Include Linux ARM64 + OpenSSL 3.0.x engine for Docker runtime, alongside native.
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  stripeCustomerId String?
  role             String    @default("user")

  accounts                Account[]
  sessions                Session[]
  subscriptions           Subscription[]
  notificationPreferences NotificationPreferences?
  devices                 Device[]
  vpnPeers                VpnPeer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  oauth_token_secret       String?
  oauth_token              String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String    @unique
  priceId              String
  status               String
  tier                 String    @default("basic")
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Processed Stripe webhook events (idempotency / replay dedup). The webhook
// handler inserts the event ID before processing; a unique violation means the
// event was already handled, so Stripe replays are acked without re-running
// side effects (e.g. transactional emails). Rows are removed again when
// processing fails retryably, so Stripe's retry is processed normally.
model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  // Supports retention cleanup: old rows are pruned opportunistically by the
  // webhook handler. Stripe stops retrying an event after ~3 days, so rows
  // older than the retention window can never be legitimate replays.
  @@index([createdAt])
}

model NotificationPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketing     Boolean @default(true)
  transactional Boolean @default(true)
  security      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Device {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String
  publicKey       String    @unique
  machineId       String? // Unique identifier for the physical device
  serverId        String?
  // Tunnel IP allocated to this device from the VPN address pool. Unique per
  // server so two devices on the same node can never collide (see
  // apps/web/lib/networking.ts for the transactional allocator).
  assignedIp      String?
  status          String    @default("pending") // "pending" | "active"
  lastConnectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serverId, assignedIp])
  @@index([userId])
  @@index([status])
  @@index([userId, machineId])
}

// Control plane: VPN servers, peers, tokens, metrics

model VpnServer {
  id                  String   @id
  publicIp            String?
  publicKey           String?
  metadata            Json?
  wgEndpoint          String?
  wgPort              Int?
  ovpnEndpoint        String?
  ovpnPort            Int?
  ovpnCaBundle        String?
  ovpnPeerFingerprint String?
  ikev2Remote         String?
  status              String
  lastSeen            DateTime

  peers   VpnPeer[]
  metrics VpnMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Online-window filtering for /servers and /metrics/targets (http_sd).
  @@index([lastSeen])
}

model VpnPeer {
  publicKey String @id
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  serverId String?
  server   VpnServer? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  allowedIps String[]
  country    String?
  region     String?
  active     Boolean   @default(true)
  username   String?   @unique
  password   String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([userId])
  // Hot path: nodes poll GET /server/peers filtering on (serverId, active).
  @@index([serverId, active])
}

// VPN node bearer tokens. The raw token is NEVER stored — only its SHA-256
// hash (tokenHash). The raw value is shown to the operator exactly once at
// creation. `tokenPrefix` is the first few characters, kept only for display
// so admins can tell tokens apart in the UI.
model VpnToken {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  tokenPrefix String
  label       String
  createdAt   DateTime @default(now())
  usageCount  Int      @default(0)
  active      Boolean  @default(true)
}

model VpnMetric {
  id        String    @id @default(cuid())
  serverId  String
  server    VpnServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  timestamp DateTime  @default(now())

  cpu          Float?
  memory       Float?
  activePeers  Int?
  // Cumulative tunnel throughput counters (bytes) reported by the node, summed
  // across all backends. Nullable so older rows and nodes that do not report
  // them remain valid. Surfaced (aggregated) on the public transparency page.
  egressBytes  Float?
  ingressBytes Float?
  region       String?

  @@index([serverId, timestamp])
  // Retention prune deletes rows older than a cutoff regardless of server.
  @@index([timestamp])
}

// Per-peer cumulative transfer samples pushed by nodes alongside VpnMetric.
// Counters are cumulative-since-daemon-start RAW values: consumers compute
// reset-aware deltas (if current < previous, the delta is the current value).
// Identity is protocol-dependent: WireGuard peers report `publicKey`,
// OpenVPN/IKEv2 sessions report `username` (the device id used as the EAP /
// auth identity). Intentionally NO foreign key to VpnServer so ingestion never
// races registration and per-user usage history survives server deletion.
model PeerMetric {
  id        String   @id @default(cuid())
  serverId  String
  publicKey String?
  username  String?
  rxBytes   BigInt
  txBytes   BigInt
  timestamp DateTime @default(now())

  // Mirror VpnMetric's indexes (per-server reads + retention prune) plus the
  // identity lookups used by the per-user usage dashboard.
  @@index([serverId, timestamp])
  @@index([timestamp])
  @@index([publicKey, timestamp])
  @@index([username, timestamp])
}

// Short-lived desktop login codes used to link the vpnVPN desktop app without
// relying on OS-level deep link handling.
model DesktopLoginCode {
  id         String    @id @default(cuid())
  email      String
  code       String
  url        String
  expiresAt  DateTime
  consumedAt DateTime?
  // Failed verification attempts against this code; the code is invalidated
  // once this exceeds the lockout threshold (brute-force protection).
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, code])
  @@index([expiresAt])
}
