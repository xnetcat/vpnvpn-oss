# =============================================================================
# vpnVPN Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# This file is used by local development and Railway deployment.

# -----------------------------------------------------------------------------
# Environment (staging | production)
# -----------------------------------------------------------------------------
ENVIRONMENT=staging

# -----------------------------------------------------------------------------
# Database (Neon for production, local Postgres for dev)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/vpnvpn

# -----------------------------------------------------------------------------
# Control Plane Service
# -----------------------------------------------------------------------------
# URL is the Railway service endpoint (or localhost for dev)
CONTROL_PLANE_API_URL=https://vpnvpn-control-plane-staging.up.railway.app
CONTROL_PLANE_API_KEY=your-control-plane-api-key
CONTROL_PLANE_BOOTSTRAP_TOKEN=dummy-token

# AES-256-GCM key for encrypting VPN peer passwords at rest (base64, 32 bytes).
# Generate with: openssl rand -base64 32
# Optional: when unset, peer passwords are stored in plaintext (local/e2e
# stacks) and the control plane logs a startup warning.
PEER_CREDENTIALS_KEY=

# Optional control-plane operational tunables (defaults shown; leave unset
# unless you need to change them).
# HTTP listen port.
# PORT=4000
# Redis URL for a shared rate-limit store (requires installing ioredis in
# services/control-plane; it is imported lazily at startup). When unset — or
# when ioredis cannot be loaded — rate limits fall back to in-memory per
# process (a warning is logged; NOT safe across replicas), so keep
# numReplicas=1 (see railway.toml).
# RATE_LIMIT_REDIS_URL=redis://localhost:6379
# Port assumed for node metrics targets returned by GET /metrics/targets
# (the node's ADMIN_PORT).
# METRICS_TARGET_PORT=8080
# Metrics retention: prune VpnMetric/PeerMetric rows older than this many
# days, on this interval.
# METRICS_RETENTION_DAYS=30
# METRICS_RETENTION_INTERVAL_MS=3600000
# Bootstrap-token upsert retries at startup (tolerates DB not ready yet).
# BOOTSTRAP_MAX_ATTEMPTS=15
# BOOTSTRAP_RETRY_DELAY_MS=2000
# Run `prisma migrate deploy` in the app boot path (local Docker/CI only —
# production uses railway.toml's preDeployCommand instead; leave unset there).
# PRISMA_MIGRATE_DEPLOY_ON_BOOT=1
# PRISMA_SCHEMA_PATH=./prisma/schema.prisma
# MIGRATE_MAX_ATTEMPTS=12
# MIGRATE_RETRY_DELAY_MS=2000

# -----------------------------------------------------------------------------
# Web App (NextAuth)
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://staging.vpnvpn.dev
NEXTAUTH_SECRET=your-nextauth-secret

# Base URL of the desktop release bucket (required by the web app; serves
# downloads from <DESKTOP_BUCKET_URL>/releases/<ENVIRONMENT>).
DESKTOP_BUCKET_URL=https://bucket.vpnvpn.dev

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=noreply@vpnvpn.dev
# Required by the NextAuth EmailProvider type. Magic-link delivery actually goes
# through Resend (custom sendVerificationRequest), so this can be a dummy SMTP URL.
EMAIL_SERVER=smtp://user:pass@localhost:587

# -----------------------------------------------------------------------------
# Stripe Billing
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_BASIC=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...
# Optional yearly price IDs. Leave unset to keep monthly-only billing — when
# absent, yearly billing is disabled and the app behaves exactly as before.
# STRIPE_PRICE_BASIC_YEARLY=price_...
# STRIPE_PRICE_PRO_YEARLY=price_...
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_...

# -----------------------------------------------------------------------------
# VPN Token (for local development and VPN node registration)
# -----------------------------------------------------------------------------
VPN_TOKEN=dummy-token

# Note: the desktop app's VITE_* variables live in apps/desktop/.env.example.

# -----------------------------------------------------------------------------
# Optional: Redis-backed rate limiting (web app)
# When unset, rate limits are tracked in-memory per instance (fine for
# single-instance deployments). Set to share limits across replicas.
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
